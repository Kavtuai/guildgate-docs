{
  "name": "guildgate-docs",
  "version": "0.3.1",
  "private": true,
  "description": "GuildGate 1.0.0 için Türkçe ve İngilizce dokümantasyon sitesi",
  "scripts": {
    "start": "docusaurus start",
    "dev": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "editorial:check": "node scripts/editorial-check.mjs",
    "source:check": "node scripts/source-check.mjs",
    "command:check": "node scripts/command-engine-check.mjs",
    "site:check": "node scripts/site-check.mjs",
    "check": "npm run search:index && npm run editorial:check && npm run source:check && npm run command:check && npm run site:check",
    "validate": "npm run check && npm run build",
    "start:en": "docusaurus start --locale en",
    "write-translations": "docusaurus write-translations",
    "search:index": "node scripts/build-search-index.mjs",
    "prestart": "npm run search:index",
    "predev": "npm run search:index",
    "prebuild": "npm run search:index",
    "prestart:en": "npm run search:index"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "^3.1.0",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.5",
    "react-dom": "19.2.5"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kavtuai/guildgate-docs.git"
  },
